---
import { ensureSchema, pool } from "../lib/db";
let status = 200; let body = { ok:true, app:"astro-product-catalog" };
try { await ensureSchema(); const r = await pool.query("SELECT NOW() AS database_time, COUNT(*)::int AS product_count FROM products"); body.database="connected"; body.databaseTime=r.rows[0].database_time; body.productCount=r.rows[0].product_count; }
catch(e) { status=503; body={ok:false,database:"disconnected",error:e instanceof Error ? e.message : "Database check failed"}; }
Astro.response.status=status; Astro.response.headers.set("Content-Type","application/json; charset=utf-8");
---
{JSON.stringify(body)}