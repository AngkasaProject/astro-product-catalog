---
import Base from "../../layouts/Base.astro"; import { isAdmin } from "../../lib/auth"; import { ensureSchema,pool } from "../../lib/db";
if(!(await isAdmin(Astro.cookies))) return Astro.redirect("/admin/login");
let products=[]; let errorMessage="";
try { await ensureSchema(); products=(await pool.query("SELECT id,name,description,price::text,image_url FROM products ORDER BY created_at DESC")).rows; } catch(e) { errorMessage="Database tidak dapat dihubungi."; }
const notice=Astro.url.searchParams.get("status"); const money=v=>new Intl.NumberFormat("id-ID",{style:"currency",currency:"IDR",maximumFractionDigits:0}).format(Number(v));
---
<Base title="Dashboard Produk"><div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10"><div class="mb-8 flex flex-wrap items-center justify-between gap-4"><div><p class="text-sm font-medium text-muted-foreground">Workspace / Produk</p><h1 class="mt-2 text-3xl font-semibold tracking-tight">Dashboard produk</h1><p class="mt-2 text-sm text-muted-foreground">Kelola katalog publik dan data produk.</p></div><div class="flex gap-2"><a href="/" class="inline-flex h-9 items-center rounded-md border border-border bg-card px-3 text-sm font-medium hover:bg-muted">Lihat katalog</a><form method="post" action="/api/logout"><button class="h-9 rounded-md border border-border bg-card px-3 text-sm font-medium hover:bg-muted">Keluar</button></form></div></div>
{notice && <div class="mb-5 rounded-lg border border-primary/40 bg-primary/10 p-3 text-sm">Perubahan produk tersimpan.</div>}{errorMessage && <div class="mb-5 rounded-lg border border-destructive/30 bg-destructive/5 p-3 text-sm text-destructive">{errorMessage}</div>}
<div class="mb-6 grid gap-4 sm:grid-cols-3"><div class="rounded-xl border border-border bg-card p-5 shadow-sm"><p class="text-sm text-muted-foreground">Total produk</p><p class="mt-2 text-3xl font-semibold">{products.length}</p></div><div class="rounded-xl border border-border bg-card p-5 shadow-sm"><p class="text-sm text-muted-foreground">Database</p><p class="mt-2 text-xl font-semibold">PostgreSQL</p><p class="mt-1 text-xs text-muted-foreground">Data persisten</p></div><div class="rounded-xl border border-border bg-card p-5 shadow-sm"><p class="text-sm text-muted-foreground">Status aplikasi</p><p class="mt-2 text-xl font-semibold">● Aktif</p><a href="/health" target="_blank" rel="noreferrer" class="mt-1 block text-xs text-muted-foreground underline">Tes koneksi database</a></div></div>
<div class="grid items-start gap-6 lg:grid-cols-[.85fr_1.15fr]"><section class="rounded-xl border border-border bg-card shadow-sm"><div class="border-b border-border p-5"><h2 class="font-semibold">Tambah produk</h2><p class="mt-1 text-sm text-muted-foreground">Lengkapi informasi produk baru.</p></div><form class="space-y-4 p-5" method="post" action="/api/products"><div class="space-y-2"><label for="name" class="text-sm font-medium">Nama produk *</label><input id="name" name="name" maxlength="160" required placeholder="Contoh: Jersey custom" class="h-10 w-full rounded-md border border-input bg-background px-3 text-sm shadow-sm outline-none focus-visible:ring-2 focus-visible:ring-ring"/></div><div class="space-y-2"><label for="description" class="text-sm font-medium">Deskripsi</label><textarea id="description" name="description" maxlength="2000" placeholder="Deskripsi singkat..." class="min-h-24 w-full rounded-md border border-input bg-background px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-2 focus-visible:ring-ring"></textarea></div><div class="space-y-2"><label for="price" class="text-sm font-medium">Harga (Rupiah) *</label><input id="price" name="price" type="number" min="0" step="1" required placeholder="150000" class="h-10 w-full rounded-md border border-input bg-background px-3 text-sm shadow-sm outline-none focus-visible:ring-2 focus-visible:ring-ring"/></div><div class="space-y-2"><label for="image_url" class="text-sm font-medium">URL gambar</label><input id="image_url" name="image_url" type="url" maxlength="1000" placeholder="https://..." class="h-10 w-full rounded-md border border-input bg-background px-3 text-sm shadow-sm outline-none focus-visible:ring-2 focus-visible:ring-ring"/></div><button class="h-10 w-full rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow-sm hover:opacity-90" type="submit">+ Simpan produk</button></form></section>
<section class="overflow-hidden rounded-xl border border-border bg-card shadow-sm"><div class="flex items-center justify-between border-b border-border p-5"><div><h2 class="font-semibold">Produk tersimpan</h2><p class="mt-1 text-sm text-muted-foreground">Daftar produk publik.</p></div><span class="rounded-md bg-muted px-2 py-1 text-xs">{products.length} item</span></div><div class="divide-y divide-border">{products.map(p=><div class="flex gap-3 p-4"><div class="grid size-14 shrink-0 place-items-center overflow-hidden rounded-lg border border-border bg-muted">{p.image_url?<img src={p.image_url} alt="" class="size-full object-cover"/>:<span class="text-2xl text-muted-foreground">◇</span>}</div><div class="min-w-0 flex-1"><p class="truncate text-sm font-medium">{p.name}</p><p class="mt-1 text-sm font-semibold">{money(p.price)}</p><p class="mt-1 line-clamp-1 text-xs text-muted-foreground">{p.description||"Tidak ada deskripsi."}</p><div class="mt-3 flex gap-2"><a href={`/admin/edit/${p.id}`} class="inline-flex h-8 items-center rounded-md border border-border px-3 text-xs hover:bg-muted">Edit</a><form method="post" action={`/api/products/${p.id}/delete`} onsubmit="return confirm('Hapus produk ini?')"><button class="h-8 rounded-md border border-destructive/30 px-3 text-xs text-destructive">Hapus</button></form></div></div></div>)}{products.length===0&&<div class="p-10 text-center text-sm text-muted-foreground">Belum ada produk.</div>}</div></section></div></div></Base>