---
import Base from "../../../layouts/Base.astro";
import { isAdmin } from "../../../lib/auth";
import { ensureSchema, pool } from "../../../lib/db";

if (!(await isAdmin(Astro.cookies))) return Astro.redirect("/admin/login");
const id = Number(Astro.params.id);
if (!Number.isSafeInteger(id) || id < 1) return new Response("ID produk tidak valid", { status: 400 });
await ensureSchema();
const result = await pool.query("SELECT id, name, description, price::text, image_url FROM products WHERE id = $1", [id]);
if (result.rowCount === 0) return new Response("Produk tidak ditemukan", { status: 404 });
const product = result.rows[0];
---
<Base title={`Edit ${product.name} · Katalog Produk`}>
  <div class="shell adminwrap" style="max-width:760px">
    <div class="adminhead"><div><div class="eyebrow">Product editor</div><h1>Edit produk</h1></div><a class="btn secondary" href="/admin">Kembali</a></div>
    <section class="panel">
      <form class="formgrid" method="post" action={`/api/products/${product.id}`}>
        <div class="field"><label for="name">Nama produk *</label><input id="name" name="name" value={product.name} maxlength="160" required /></div>
        <div class="field"><label for="description">Deskripsi</label><textarea id="description" name="description" maxlength="2000">{product.description}</textarea></div>
        <div class="field"><label for="price">Harga (Rupiah) *</label><input id="price" name="price" type="number" min="0" step="1" value={Number(product.price)} required /></div>
        <div class="field"><label for="image_url">URL gambar (opsional)</label><input id="image_url" name="image_url" type="url" maxlength="1000" value={product.image_url} /></div>
        <button class="btn" type="submit">Simpan perubahan</button>
      </form>
    </section>
  </div>
</Base>