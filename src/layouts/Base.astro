---
const { title = "Katalog Produk" } = Astro.props;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101114" />
    <title>{title}</title>
    <style>
      :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#f4f4f5;background:#101114;font-synthesis:none;text-rendering:optimizeLegibility}
      *{box-sizing:border-box}body{margin:0;min-height:100vh}a{color:inherit;text-decoration:none}button,input,textarea{font:inherit}
      .shell{width:min(1120px,calc(100% - 32px));margin:auto}.topbar{border-bottom:1px solid #2b2c32;background:#15161a}.nav{height:72px;display:flex;align-items:center;justify-content:space-between;gap:16px}.brand{font-size:18px;font-weight:800;letter-spacing:-.04em}.brand span{color:#a3e635}.navlinks{display:flex;gap:18px;color:#c4c4cc;font-size:14px}
      .hero{padding:58px 0 36px}.eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:.15em;color:#a3e635;font-weight:800}.hero h1{font-size:clamp(34px,6vw,58px);line-height:1.04;letter-spacing:-.055em;max-width:760px;margin:14px 0}.muted{color:#a1a1aa;line-height:1.65}.products{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:18px;padding:18px 0 64px}.card{background:#18191e;border:1px solid #2b2c32;border-radius:16px;overflow:hidden}.product-image{height:190px;background:#222329;display:flex;align-items:center;justify-content:center;color:#777;overflow:hidden}.product-image img{width:100%;height:100%;object-fit:cover}.placeholder{font-size:42px;font-weight:900;color:#4b4d56}.cardbody{padding:16px}.card h2{font-size:17px;margin:0 0 8px}.desc{color:#a1a1aa;font-size:13px;line-height:1.55;min-height:40px}.price{font-weight:800;font-size:18px;margin-top:14px;color:#d9f99d}
      .btn{border:0;border-radius:10px;background:#a3e635;color:#17180f;font-weight:800;padding:11px 15px;display:inline-flex;align-items:center;justify-content:center;cursor:pointer}.btn.secondary{background:#27282f;color:#eee;border:1px solid #3b3c45}.btn.danger{background:#7f1d1d;color:#fff}.btn.full{width:100%}.panel{background:#18191e;border:1px solid #2b2c32;border-radius:16px;padding:22px}.formgrid{display:grid;gap:14px}.field{display:grid;gap:7px}.field label{font-size:13px;color:#d4d4d8}.field input,.field textarea{width:100%;background:#101114;border:1px solid #3b3c45;border-radius:9px;padding:12px;color:#f4f4f5;outline:none}.field input:focus,.field textarea:focus{border-color:#a3e635}.field textarea{min-height:92px;resize:vertical}.notice{border:1px solid #3b3c45;background:#202127;padding:12px 14px;border-radius:10px;margin:14px 0;color:#d4d4d8;font-size:14px}.notice.error{border-color:#7f1d1d;color:#fecaca}.notice.success{border-color:#365314;color:#d9f99d}.adminwrap{padding:34px 0 64px}.adminhead{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:22px}.adminhead h1{margin:0;letter-spacing:-.04em}.tablewrap{overflow:auto;margin-top:22px}table{border-collapse:collapse;width:100%;font-size:14px}th,td{text-align:left;padding:13px 10px;border-bottom:1px solid #303139;vertical-align:top}th{color:#a1a1aa;font-weight:600}td.actions{white-space:nowrap}.inline{display:flex;gap:8px;align-items:center}.footer{border-top:1px solid #2b2c32;color:#71717a;padding:22px 0;font-size:12px}
      @media(max-width:600px){.nav{height:62px}.navlinks{gap:12px;font-size:12px}.hero{padding-top:42px}.panel{padding:16px}.products{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.product-image{height:130px}.cardbody{padding:12px}.card h2{font-size:15px}.desc{font-size:12px}.price{font-size:15px}.shell{width:min(100% - 22px,1120px)}}
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="shell nav">
        <a class="brand" href="/">KATALOG<span>.</span></a>
        <nav class="navlinks"><a href="/">Produk</a><a href="/admin">Dashboard</a></nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="footer"><div class="shell">Astro Product Catalog · Self-hosted on Coolify</div></footer>
  </body>
</html>