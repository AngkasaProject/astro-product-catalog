---
import "../styles/global.css";
const { title = "Katalog Produk" } = Astro.props;
---
<!doctype html><html lang="id"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#fff"/><title>{title}</title></head>
<body class="min-h-screen bg-background font-sans text-foreground antialiased">
<header class="sticky top-0 z-30 border-b border-border/80 bg-background/90 backdrop-blur-xl"><div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
<a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight"><span class="grid size-8 place-items-center rounded-lg bg-primary text-primary-foreground">◇</span>Katalog<span class="text-muted-foreground">.store</span></a>
<nav class="flex gap-1 text-sm"><a href="/" class="rounded-md px-3 py-2 text-muted-foreground hover:bg-muted hover:text-foreground">Produk</a><a href="/admin" class="rounded-md px-3 py-2 text-muted-foreground hover:bg-muted hover:text-foreground">Dashboard</a></nav></div></header>
<main><slot/></main><footer class="border-t border-border bg-card"><div class="mx-auto flex max-w-6xl justify-between px-4 py-6 text-xs text-muted-foreground sm:px-6"><span>© {new Date().getFullYear()} Katalog.store</span><span>Astro · PostgreSQL · Coolify</span></div></footer></body></html>